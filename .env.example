# ============================================================================
# CyberMarketTrack — environment variables template
# Copy this file to .env and adjust the values. NEVER commit the real .env.
# ============================================================================

# SQLite database file (relative to project root). Keep it under data/ so the
# Docker volume and the backup script cover it.
DATABASE_URL="file:./data/cybermarkettrack.db"

# No admin credentials here: on first run (empty database) the admin account is
# created from the login page — you choose the username and password there. So
# no default password is ever stored in the repo or the environment.

# Freshness threshold in months: entities not updated for longer get the
# "to re-check" badge (default 12)
FRESHNESS_MONTHS="12"

# Auth.js session encryption secret. Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# Required when self-hosting (Docker) so Auth.js trusts the Host header
AUTH_TRUST_HOST="true"

# =============================================================================
# Phase 2 — RSS→LLM auto-proposals. Switch modes by changing these vars only.
# =============================================================================
# Mode 1 — LOCAL (Ollama on the same host):
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434
#   LLM_MODEL=qwen2.5:7b
# Mode 2 — DEPORTED (Ollama on another machine, may be OFF -> job skips):
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://192.168.1.42:11434     # your PC's LAN IP
#   LLM_MODEL=qwen2.5:7b
# Mode 3 — HOSTED (Anthropic, e.g. Haiku):
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-haiku-4-5-20251001
#   LLM_API_KEY=sk-ant-...
LLM_PROVIDER="ollama"
LLM_BASE_URL="http://localhost:11434"
LLM_MODEL="qwen2.5:7b"
# LLM_API_KEY=""            # only for LLM_PROVIDER=anthropic
LLM_TIMEOUT_MS="60000"
RSS_MAX_PER_RUN="12"        # items analyzed per run (backlog handles the rest)

# Secret so a NAS scheduler can POST /api/rss/analyze without a login session.
# CRON_SECRET="replace-with-a-long-random-string"

# GPU too old for Ollama's CUDA build (e.g. GTX 900-series / Maxwell) crashes with
# "PTX ... unsupported toolchain". Force CPU inference (AVX2 required) with:
OLLAMA_NUM_GPU="0"
